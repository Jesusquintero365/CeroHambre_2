# ======================================================
# Variables de entorno de CeroHambre
# Copia este archivo como ".env" (en la raíz del proyecto) y completa los valores.
# NUNCA subas el archivo .env a GitHub (ya está en .gitignore).
# ======================================================

# Entorno: development | production
NODE_ENV=development

# Puerto del servidor (en Render lo asigna la plataforma automáticamente)
PORT=3000

# Cadena de conexión a PostgreSQL
#   formato: postgresql://USUARIO:CLAVE@HOST:PUERTO/NOMBRE_BD
DATABASE_URL=postgresql://postgres:TU_CLAVE@localhost:5432/cerohambre

# "true" si el servidor de BD exige SSL (por ejemplo, al usar la URL externa de Render)
DATABASE_SSL=false

# Llave secreta para firmar las sesiones. Usa un texto largo y aleatorio.
JWT_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria

# Duración de la sesión en horas (opcional, por defecto 8)
SESION_HORAS=8

# Zona horaria para validar fechas (opcional, por defecto America/Bogota)
ZONA_HORARIA=America/Bogota

# "false" para NO cargar los datos de ejemplo al crear la base de datos (opcional)
CARGAR_DATOS_EJEMPLO=true
